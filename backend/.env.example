PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/movv_parceiros

# JWT
JWT_SECRET=sua_chave_secreta_muito_longa_e_segura_aqui
JWT_EXPIRES_IN=7d

# Z-API WhatsApp
ZAPI_INSTANCE_ID=sua_instancia_zapi
ZAPI_TOKEN=seu_token_zapi
ZAPI_CLIENT_TOKEN=seu_client_token_zapi

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Cloudinary (fotos de perfil/estabelecimento/produtos do Portal do Parceiro)
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# Resend (envio de email transacional)
RESEND_API_KEY=re_sua_chave_aqui

# OpenAI (IA Assistente de cadastro de produtos -- analisa a foto e sugere
# nome/descrição/marca/categoria; ver openaiService.js). Sem essa chave o
# endpoint POST /api/parceiro/produtos/analisar-imagem responde 502 com
# mensagem amigável -- não derruba o resto do sistema.
# Como obter: platform.openai.com -> API keys -> Create new secret key.
# É pago por uso (sem plano fixo); modelo usado é o gpt-4o com imagem em
# detail "low" pra reduzir custo -- confira o preço atual em
# openai.com/api/pricing antes de liberar em produção.
OPENAI_API_KEY=sk-sua-chave-aqui

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# Mercado Pago (assinatura dos planos do parceiro: PIX mensal + cartão
# recorrente, trial 7 dias — ver src/config/mercadopago.js).
# Painel MP -> Suas integrações -> (aplicação) -> Credenciais de teste / de produção.
# MP_AMBIENTE=test usa as *_TEST; só "prod" usa as *_PROD (qualquer outro
# valor cai em test). Credencial de teste começa com "TEST-", de produção
# com "APP_USR-" — o backend recusa se estiver trocada.
MP_AMBIENTE=test
MP_ACCESS_TOKEN_TEST=TEST-sua-chave-aqui
MP_PUBLIC_KEY_TEST=TEST-sua-chave-aqui
MP_ACCESS_TOKEN_PROD=
MP_PUBLIC_KEY_PROD=
# Painel MP -> Webhooks -> "Assinatura secreta" (gerada ao salvar a URL de
# notificação https://<backend>/api/webhook/mercadopago).
MP_WEBHOOK_SECRET=
# Opcional: manda a URL do webhook em cada PIX (se preferir não depender só
# da configuração do painel do MP).
MP_NOTIFICATION_URL=

# Segredo do Render Cron Job que chama POST /api/interno/assinaturas/rotina
# (header x-cron-secret). Gere um valor aleatório longo.
CRON_SECRET=
