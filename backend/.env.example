PORT=3001
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/movv_parceiros

# JWT
JWT_SECRET=sua_chave_secreta_muito_longa_e_segura_aqui
JWT_EXPIRES_IN=7d

# Z-API WhatsApp
ZAPI_INSTANCE_ID=sua_instancia_zapi
ZAPI_TOKEN=seu_token_zapi
ZAPI_CLIENT_TOKEN=seu_client_token_zapi

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Cloudinary (fotos de perfil/estabelecimento/produtos do Portal do Parceiro)
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret

# Resend (envio de email transacional)
RESEND_API_KEY=re_sua_chave_aqui

# OpenAI (IA Assistente de cadastro de produtos -- analisa a foto e sugere
# nome/descrição/marca/categoria; ver openaiService.js). Sem essa chave o
# endpoint POST /api/parceiro/produtos/analisar-imagem responde 502 com
# mensagem amigável -- não derruba o resto do sistema.
# Como obter: platform.openai.com -> API keys -> Create new secret key.
# É pago por uso (sem plano fixo); modelo usado é o gpt-4o com imagem em
# detail "low" pra reduzir custo -- confira o preço atual em
# openai.com/api/pricing antes de liberar em produção.
OPENAI_API_KEY=sk-sua-chave-aqui

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173
